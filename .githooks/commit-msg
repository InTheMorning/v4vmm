#!/usr/bin/env bash
# Block commits that credit AI tools (Copilot, Claude, GPT, Codex, …).
# Project policy: no AI co-author trailers, no "Generated by …" lines,
# no "with help from <AI>" mentions in commit messages.
#
# Install:
#   git config core.hooksPath .githooks
#
# Bypass (use sparingly, only for genuine human co-authors named after a tool):
#   git commit --no-verify ...

set -euo pipefail

msg_file="${1:?missing commit message file argument}"

# Strip comment lines (the editor template) before scanning.
content="$(grep -v '^#' "$msg_file" || true)"

# Patterns that should never appear. Case-insensitive.
# Each entry: "<human-readable label>|<extended regex>"
patterns=(
    "Co-authored-by: Copilot|^[[:space:]]*Co-authored-by:.*\bcopilot\b"
    "Co-authored-by: Claude|^[[:space:]]*Co-authored-by:.*\bclaude\b"
    "Co-authored-by: GPT|^[[:space:]]*Co-authored-by:.*\b(gpt|chatgpt|openai)\b"
    "Co-authored-by: Codex|^[[:space:]]*Co-authored-by:.*\bcodex\b"
    "Co-authored-by: Gemini|^[[:space:]]*Co-authored-by:.*\bgemini\b"
    "Co-authored-by: Cursor|^[[:space:]]*Co-authored-by:.*\bcursor\b"
    "Co-authored-by: Anthropic|^[[:space:]]*Co-authored-by:.*\banthropic\b"
    "Co-authored-by: noreply.*Copilot|^[[:space:]]*Co-authored-by:.*223556219\+Copilot@users\.noreply\.github\.com"
    "Generated/Authored by AI|\b(generated|written|authored|created|produced)[[:space:]]+by[[:space:]]+(an[[:space:]]+)?(ai|copilot|claude|chatgpt|gpt|codex|cursor|gemini|opus|sonnet|haiku)\b"
    "Assisted/With help from AI|\b(with[[:space:]]+(help|assistance)[[:space:]]+from|assisted[[:space:]]+by)[[:space:]]+(an[[:space:]]+)?(ai|copilot|claude|chatgpt|gpt|codex|cursor|gemini|opus|sonnet|haiku)\b"
    "🤖 Generated with …|🤖[[:space:]]*Generated[[:space:]]+with"
)

violations=()
for entry in "${patterns[@]}"; do
    label="${entry%%|*}"
    regex="${entry#*|}"
    if printf '%s\n' "$content" | grep -Eiq -- "$regex"; then
        violations+=("$label")
    fi
done

if (( ${#violations[@]} > 0 )); then
    {
        echo "ERROR: commit message credits AI tools — project policy forbids this."
        echo
        echo "Matched patterns:"
        for v in "${violations[@]}"; do
            echo "  - $v"
        done
        echo
        echo "Remove the offending line(s) and try again."
        echo "If a real human contributor genuinely shares one of these names,"
        echo "bypass with: git commit --no-verify"
    } >&2
    exit 1
fi
