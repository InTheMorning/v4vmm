+fn grapheme_boundary(text: &str, offset: usize, forward: bool) -> usize {
+    let mut cursor = GraphemeCursor::new(offset, text.len(), true);
+    if cursor
+        .is_boundary(text, 0)
+        .expect("complete text supplies grapheme context")
+    {
+        return offset;
+    }
+    let boundary = if forward {
+        cursor.next_boundary(text, 0)
+    } else {
+        cursor.prev_boundary(text, 0)
+    };
+    boundary
+        .expect("complete text supplies grapheme context")
+        .expect("an interior grapheme position has both endpoints")
 }
 
