+    fn word_selection_preserves_graphemes_in_rope() {
+        let long_prefix = format!("{} ", "x".repeat(4096));
+        for prefix in ["", "previous row\n", "previous row\r\n", &long_prefix] {
+            for suffix in ["", ".", "\nnext row", "\r\nnext row"] {
