+                    let text = format!("{prefix}中文 {cluster}{suffix}");
+                    let rope = Rope::from(text.as_str());
+                    for (local, _) in cluster.char_indices() {
+                        let range =
+                            TextSelector::word_range(&rope, prefix.len() + "中文 ".len() + local)
+                                .unwrap();
+                        assert_eq!(
+                            rope.slice(range).to_string(),
+                            cluster,
+                            "{text:?} at {local}"
+                        );
+                    }
+                }
+            }
+        }
+    }
